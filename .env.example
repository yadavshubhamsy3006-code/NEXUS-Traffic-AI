# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# Optional Supabase PostgreSQL configuration for cloud persistence
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Optional Eclipse SUMO binary path (if installed locally)
SUMO_BINARY="sumo"
SUMO_HOME=""

# Local SQLite database file path (defaults to ./nexus_traffic.db)
DATABASE_PATH="./nexus_traffic.db"
